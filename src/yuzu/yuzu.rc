#include "winresrc.h"
#include "jinra_build_version.h"

1 VERSIONINFO
FILEVERSION JINRA_WINDOWS_VERSION
PRODUCTVERSION JINRA_WINDOWS_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Jinra\0"
            VALUE "FileVersion", JINRA_VERSION_STRING "\0"
            VALUE "InternalName", "jinra\0"
            VALUE "OriginalFilename", "jinra.exe\0"
            VALUE "ProductName", "Jinra\0"
            VALUE "ProductVersion", JINRA_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
// QT requires that the default application icon is named IDI_ICON1

IDI_ICON1               ICON                    "../../dist/jinra.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

0                       RT_MANIFEST             "../../dist/yuzu.manifest"
