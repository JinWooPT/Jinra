        <file alias="hangy.png">../../dist/jinra-avatars/hangy.png</file>
        <file alias="retsuko.png">../../dist/jinra-avatars/retsuko.png</file>
        <file alias="badtz.png">../../dist/jinra-avatars/badtz.png</file>
        <file alias="choco.png">../../dist/jinra-avatars/choco.png</file>
        <file alias="kero.png">../../dist/jinra-avatars/kero.png</file>
        <file alias="pom.png">../../dist/jinra-avatars/pom.png</file>
        <file alias="poch.png">../../dist/jinra-avatars/poch.png</file>
