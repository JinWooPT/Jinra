}
QWidget#progressDetails, QLabel { background: transparent; border: none; }
QLabel { color: #e6edf7; font-family: "Segoe UI"; font-size: 10pt; }
QLabel#brandName { color: #35d9ed; font-size: 9pt; font-weight: 700; }
QLabel#stage { color: #f3f8ff; font-size: 22pt; font-weight: 600; }
QLabel#preparationNote, QLabel#value { color: #a4b7d1; }
QLabel#progressPercent { color: #55ddf1; font-weight: 600; }
QProgressBar#progress_bar {
 background: #0a1220;
 border: 1px solid #29415e;
 border-radius: 5px;
}
QProgressBar#progress_bar::chunk {
 background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #087fe5, stop: 1 #35d9ed);
 border-radius: 4px;
}
QPushButton#playNow {
 background: #087fe5;
 color: #ffffff;
 border: 1px solid #278dff;
 border-radius: 6px;
 padding: 8px 20px;
 font-family: "Segoe UI";
 font-size: 10pt;
 font-weight: 600;
}
QPushButton#playNow:hover { background: #2198ff; }
QPushButton#playNow:focus { border-color: #7de9f6; }
QPushButton#playNow:disabled { background: #192c43; color: #a4b7d1; border-color: #31445d; }
]]></string>
