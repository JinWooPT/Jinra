+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "core/file_sys/nup_container.h"
+#include "core/loader/loader.h"
+
+namespace FileSys {
+class NACP;
+class NupContainer;
+} // namespace FileSys
+
+namespace Loader {
+
+/// Loads a NUP (NX Package) container: loose ExeFS/RomFS trees for a base
+/// program plus its updates in one file. The newest update package is layered
+/// over the base; add-on content packages are recognized but not yet mounted.
+class AppLoader_NUP final : public AppLoader {
+public:
+    explicit AppLoader_NUP(FileSys::VirtualFile file_);
+    ~AppLoader_NUP() override;
+
+    /**
+     * Identifies whether or not the given file is a NUP container.
+     *
+     * @param nup_file The file to identify.
+     *
+     * @return FileType::NUP, or FileType::Error if the file is not a NUP.
+     */
+    static FileType IdentifyType(const FileSys::VirtualFile& nup_file);
+
+    FileType GetFileType() const override {
+        return FileType::NUP;
+    }
+
+    LoadResult Load(Kernel::KProcess& process, Core::System& system) override;
+
+    ResultStatus VerifyIntegrity(std::function<bool(size_t, size_t)> progress_callback) override;
+
+    ResultStatus ReadRomFS(FileSys::VirtualFile& out_file) override;
+    bool IsRomFSUpdatable() const override;
+    ResultStatus ReadProgramId(u64& out_program_id) override;
+    ResultStatus ReadProgramIds(std::vector<u64>& out_program_ids) override;
+    ResultStatus ReadIcon(std::vector<u8>& buffer) override;
+    ResultStatus ReadTitle(std::string& title) override;
+    ResultStatus ReadControlData(FileSys::NACP& control) override;
+    ResultStatus ReadNSOModules(Modules& modules) override;
+
+private:
+    std::unique_ptr<FileSys::NupContainer> nup;
+    std::unique_ptr<AppLoader> secondary_loader;
+
+    std::unique_ptr<FileSys::NACP> nacp_file;
+    FileSys::VirtualFile icon_file;
+    u64 base_title_id{};
+    std::string display_version;
+    bool has_program{};
+};
+
+} // namespace Loader
diff --git a/src/tests/core/nup_container.cpp b/src/tests/core/nup_container.cpp
new file mode 100644
index 0000000..3cbb9c3
--- /dev/null
+++ b/src/tests/core/nup_container.cpp
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <catch2/catch_test_macros.hpp>
+#include <openssl/evp.h>
+#include <zstd.h>
+#include "core/file_sys/nup_container.h"
+#define VMA_IMPLEMENTATION
+#include "video_core/vulkan_common/vma.h"
+
+namespace {
+using Bytes = std::vector<u8>;
+void Put(Bytes& b, std::size_t offset, u64 value, unsigned width) {
+    REQUIRE(offset + width <= b.size());
+    for (unsigned i = 0; i < width; ++i)
+        b[offset + i] = static_cast<u8>(value >> (8 * i));
+}
+u64 Get(const Bytes& b, std::size_t offset, unsigned width) {
+    u64 value{};
+    for (unsigned i = 0; i < width; ++i)
+        value |= u64(b[offset + i]) << (8 * i);
+    return value;
+}
+void Hash(const u8* data, std::size_t size, u8* out) {
+    unsigned int count{};
+    REQUIRE(EVP_Digest(data, size, out, &count, EVP_sha256(), nullptr) == 1);
+    REQUIRE(count == 32);
+}
+void Rehash(Bytes& b) {
+    Hash(b.data() + 128, Get(b, 16, 8), b.data() + 24);
+}
+Bytes Fixture(bool compressed = false, std::size_t length = 4096) {
+    // root -> romfs -> payload.bin. No copyrighted game data or console keys.
+    const std::string pool = std::string("\0romfs\0payload.bin\0", 19);
+    const std::size_t dirs = 48 + 64, files = dirs + 48, children = files + 80,
+                      pool_off = children + 8;
+    const std::size_t toc_size = (pool_off + pool.size() + 15) & ~std::size_t(15);
+    Bytes payload(length, 0x71), stored = payload;
+    if (compressed) {
+        stored.resize(ZSTD_compressBound(payload.size()));
+        const auto size =
+            ZSTD_compress(stored.data(), stored.size(), payload.data(), payload.size(), 3);
+        REQUIRE_FALSE(ZSTD_isError(size));
+        stored.resize(size);
+    }
+    const auto blob = 128 + toc_size;
+    Bytes b(blob + stored.size());
+    std::memcpy(b.data(), "NUP\1", 4);
+    Put(b, 4, 128, 2);
+    Put(b, 6, 1, 2);
+    Put(b, 8, 128, 8);
+    Put(b, 16, toc_size, 8);
+    Put(b, 56, blob, 8);
+    Put(b, 64, b.size(), 8);
+    Put(b, 72, 1, 4);
+    const std::size_t t = 128;
+    std::memcpy(b.data() + t, "TOC\1", 4);
+    Put(b, t + 4, 1, 4);
+    Put(b, t + 8, 2, 8);
+    Put(b, t + 16, 1, 8);
+    Put(b, t + 24, pool_off, 8);
+    Put(b, t + 32, pool.size(), 8);
+    Put(b, t + 48, 0x040074A01BF12000ull, 8);
+    Put(b, t + 48 + 12, 0xffffffff, 4);
+    Put(b, t + 48 + 16, 1, 4);
+    Put(b, t + dirs + 8, 0, 4);
+    Put(b, t + dirs + 12, 1, 4);
+    Put(b, t + dirs + 24, 1, 4);
+    Put(b, t + dirs + 28, 5, 4);
+    Put(b, t + dirs + 32, 1, 4);
+    Put(b, t + dirs + 36, 1, 4);
+    Put(b, t + files, 7, 4);
+    Put(b, t + files + 4, 11, 4);
+    Put(b, t + files + 8, length, 8);
+    Put(b, t + files + 16, length ? blob : 0, 8);
+    Put(b, t + files + 24, stored.size(), 8);
+    Hash(payload.data(), payload.size(), b.data() + t + files + 32);
+    b[t + files + 64] = compressed ? 1 : 0;
+    Put(b, t + children, 1, 4);
+    Put(b, t + children + 4, 2, 4);
+    std::memcpy(b.data() + t + pool_off, pool.data(), pool.size());
+    std::copy(stored.begin(), stored.end(), b.begin() + blob);
+    Rehash(b);
+    return b;
+}
+FileSys::NupContainer Mount(Bytes b) {
+    return FileSys::NupContainer(
+        std::make_shared<FileSys::VectorVfsFile>(std::move(b), "test.nup"));
+}
+} // namespace
+
+TEST_CASE("NUP raw and zstd support random reads and integrity", "[nup]") {
+    for (bool compressed : {false, true}) {
+        auto nup = Mount(Fixture(compressed));
+        REQUIRE(nup.GetStatus() == Loader::ResultStatus::Success);
+        REQUIRE(nup.FindBasePackage() == 0);
+        auto file = nup.GetRomFSDir(0)->GetFile("payload.bin");
+        REQUIRE(file);
+        REQUIRE(file->ReadBytes(31, 77) == Bytes(31, 0x71));
+        REQUIRE(file->ReadBytes(20, 4090) == Bytes(6, 0x71));
+        REQUIRE(nup.VerifyIntegrity({}) == Loader::ResultStatus::Success);
+        REQUIRE(nup.VerifyIntegrity([](auto, auto) { return false; }) ==
+                Loader::ResultStatus::ErrorIntegrityVerificationFailed);
+    }
+}
+
+TEST_CASE("NUP handles empty members and streams large compressed members", "[nup]") {
+    auto empty = Mount(Fixture(false, 0));
+    REQUIRE(empty.GetStatus() == Loader::ResultStatus::Success);
+    REQUIRE(empty.GetRomFSDir(0)->GetFile("payload.bin")->GetSize() == 0);
+    REQUIRE(empty.VerifyIntegrity({}) == Loader::ResultStatus::Success);
+    const auto size = FileSys::NupDecompressCache::MaxCachedExtent + 1024;
+    auto large = Mount(Fixture(true, size));
+    REQUIRE(large.GetStatus() == Loader::ResultStatus::Success);
+    auto file = large.GetRomFSDir(0)->GetFile("payload.bin");
+    REQUIRE(file);
+    REQUIRE(file->ReadBytes(19, size - 19) == Bytes(19, 0x71));
+    REQUIRE(file->ReadBytes(113, 1000000) == Bytes(113, 0x71));
+}
+
+TEST_CASE("NUP rejects corrupt ranges counts names and directory graphs", "[nup]") {
+    constexpr std::size_t t = 128, dirs = 112, files = 160, children = 240;
+    for (int mutation = 0; mutation < 13; ++mutation) {
+        auto b = Fixture();
+        switch (mutation) {
+        case 0:
+            Put(b, 8, std::numeric_limits<u64>::max() - 3, 8);
+            break;
+        case 1:
+            Put(b, 16, std::numeric_limits<u64>::max(), 8);
+            break;
+        case 2:
+            Put(b, t + 8, std::numeric_limits<u64>::max(), 8);
+            break;
+        case 3:
+            Put(b, t + 16, std::numeric_limits<u64>::max(), 8);
+            break;
+        case 4:
+            Put(b, t + 24, std::numeric_limits<u64>::max(), 8);
+            break;
+        case 5:
+            Put(b, t + dirs + 8, 0xffffffff, 4);
+            break;
+        case 6:
+            Put(b, t + dirs + 12, 0xffffffff, 4);
+            break;
+        case 7:
+            Put(b, t + children + 4, 1, 4);
+            break;
+        case 8:
+            Put(b, t + files + 24, 4095, 8);
+            break;
+        case 9:
+            Put(b, t + files + 16, std::numeric_limits<u64>::max() - 3, 8);
+            break;
+        case 10:
+            b[t + files + 64] = 2;
+            break;
+        case 11:
+            Put(b, t + files + 4, 0xffffffff, 4);
+            break;
+        case 12:
+            b[Get(b, 8, 8) + Get(b, t + 24, 8) + 7] = '/';
+            break;
+        }
+        if (mutation >= 2)
+            Rehash(b);
+        auto nup = Mount(std::move(b));
+        INFO(mutation);
+        REQUIRE(nup.GetStatus() != Loader::ResultStatus::Success);
+    }
+    auto changed = Fixture();
+    changed[150] ^= 1;
+    REQUIRE(Mount(std::move(changed)).GetStatus() != Loader::ResultStatus::Success);
+    auto short_file = Fixture();
+    short_file.pop_back();
+    REQUIRE(Mount(std::move(short_file)).GetStatus() != Loader::ResultStatus::Success);
+    auto payload = Fixture();
+    payload.back() ^= 1;
+    auto nup = Mount(std::move(payload));
+    REQUIRE(nup.GetStatus() == Loader::ResultStatus::Success);
+    REQUIRE(nup.VerifyIntegrity({}) == Loader::ResultStatus::ErrorIntegrityVerificationFailed);
+}
+
+TEST_CASE("NUP update overlay shadows both files and directories", "[nup]") {
+    using namespace FileSys;
+    auto base = std::make_shared<VectorVfsDirectory>(
+        std::vector<VirtualFile>{std::make_shared<VectorVfsFile>(Bytes{1}, "same")},
+        std::vector<VirtualDir>{std::make_shared<VectorVfsDirectory>(
+            std::vector<VirtualFile>{}, std::vector<VirtualDir>{}, "old-dir")});
+    auto update = std::make_shared<VectorVfsDirectory>(
+        std::vector<VirtualFile>{std::make_shared<VectorVfsFile>(Bytes{2}, "old-dir")},
+        std::vector<VirtualDir>{std::make_shared<VectorVfsDirectory>(
+            std::vector<VirtualFile>{}, std::vector<VirtualDir>{}, "same")});
+    auto merged = NupContainer::MergeShadowDirs(base, update);
+    REQUIRE(merged->GetFile("same") == nullptr);
+    REQUIRE(merged->GetSubdirectory("same") != nullptr);
+    REQUIRE(merged->GetSubdirectory("old-dir") == nullptr);
+    REQUIRE(merged->GetFile("old-dir")->ReadAllBytes() == Bytes{2});
+}
diff --git a/src/video_core/buffer_cache/completed_download_coverage.h b/src/video_core/buffer_cache/completed_download_coverage.h
new file mode 100644
index 0000000..072b4a2
--- /dev/null
+++ b/src/video_core/buffer_cache/completed_download_coverage.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <algorithm>
+#include "common/range_sets.inc"
+
+namespace VideoCommon {
+// Visit completed snapshots newest first. Earlier snapshots need only write bytes
+// that no newer completed snapshot already supplied; CPU-cancelled ranges stay excluded.
+class CompletedDownloadCoverage {
+public:
+    template <typename Callback>
+    void ForEachUncovered(DAddr start, u64 size, Callback&& callback) {
+        DAddr cursor = start;
+        const DAddr end = start + size;
+        covered.ForEachInRange(start, size, [&](DAddr newer_start, DAddr newer_end) {
+            if (cursor < newer_start) callback(cursor, newer_start);
+            cursor = std::max(cursor, newer_end);
+        });
+        if (cursor < end) callback(cursor, end);
+        covered.Add(start, size);
+    }
+private:
+    Common::RangeSet<DAddr> covered;
+};
+} // namespace VideoCommon
diff --git a/src/video_core/buffer_cache/download_copy_batches.h b/src/video_core/buffer_cache/download_copy_batches.h
new file mode 100644
index 0000000..b863143
--- /dev/null
+++ b/src/video_core/buffer_cache/download_copy_batches.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <span>
+#include <utility>
+
+#include "video_core/texture_cache/types.h"
+
+namespace VideoCommon {
+
+inline constexpr size_t DOWNLOAD_COPY_BATCH_SIZE = 256;
+
+// Preserve copy order and staging offsets while sharing one command for consecutive
+// regions from the same source. The callback consumes the temporary span immediately.
+template <typename BufferId, typename Callback>
+void ForEachDownloadCopyBatch(std::span<const std::pair<BufferCopy, BufferId>> downloads,
+                              Callback&& callback) {
+    std::array<BufferCopy, DOWNLOAD_COPY_BATCH_SIZE> copies;
+    size_t first = 0;
+    while (first < downloads.size()) {
+        const BufferId buffer_id = downloads[first].second;
+        size_t count = 0;
+        do {
+            copies[count] = downloads[first + count].first;
+            ++count;
+        } while (count < copies.size() && first + count < downloads.size() &&
+                 downloads[first + count].second == buffer_id);
+        callback(buffer_id, std::span<const BufferCopy>{copies.data(), count});
+        first += count;
+    }
+}
+
+} // namespace VideoCommon
diff --git a/src/video_core/buffer_cache/mapped_prefix_cache.h b/src/video_core/buffer_cache/mapped_prefix_cache.h
new file mode 100644
index 0000000..5613e3e
--- /dev/null
+++ b/src/video_core/buffer_cache/mapped_prefix_cache.h
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+#include <limits>
+#include <mutex>
+#include <utility>
+#include <vector>
+#include "common/common_types.h"
+#include "common/container/unordered_map.h"
+#include "common/range_sets.inc"
+
+namespace VideoCommon {
+inline bool NativeSelectivePrefixCacheEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NATIVE_SELECTIVE_PREFIX_CACHE");
+        return value && value[0] == '1';
+    }();
+    return enabled;
+}
+
+inline bool NativePrefixIntervalsEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("EDEN_NATIVE_PREFIX_INTERVALS");
+        return value && value[0] == '1';
+    }();
+    return enabled;
+}
+
+class MappedPrefixCache {
+public:
+    static constexpr size_t MAX_ENTRIES = 4096;
+    static constexpr size_t MAX_DEFERRED = 128;
+
+    explicit MappedPrefixCache(bool cache_intervals = false) : use_intervals{cache_intervals} {}
+
+    template <class Probe>
+    u32 Query(size_t as_id, GPUVAddr address, u32 size, Probe&& probe) {
+        if (pending.load(std::memory_order_acquire)) ApplyInvalidations();
+        if (size > std::numeric_limits<GPUVAddr>::max() - address) {
+            return probe(address, size);
+        }
+        const u64 key = (static_cast<u64>(as_id) << 48) ^ address;
+        const auto found = entries.find(key);
+        if (found != entries.end() && found->second.as_id == as_id &&
+            found->second.address == address && found->second.size == size) {
+            ++hits;
+            return found->second.prefix;
+        }
+        u32 prefix = 0;
+        if (use_intervals) {
+            known_mapped[as_id].ForEachInRange(address, size, [&](GPUVAddr first, GPUVAddr end) {
+                if (first == address) prefix = static_cast<u32>(end - address);
+            });
+        }
+        if (prefix == size) {
+            ++range_hits;
+        } else {
+            ++walks;
+            prefix += probe(address + prefix, size - prefix);
+            if (use_intervals && prefix) known_mapped[as_id].Add(address, prefix);
+        }
+        if (entries.size() >= MAX_ENTRIES) entries.clear();
+        entries.insert_or_assign(key, Entry{as_id, address, size, prefix});
+        return prefix;
+    }
+
+    // Mapping callbacks may arrive from another thread. Apply them on the cache owner.
+    void Invalidate(size_t as_id, GPUVAddr address, u64 size) {
+        if (!size) return;
+        std::scoped_lock lock{mutex};
+        if (invalidations.size() == MAX_DEFERRED) {
+            invalidations.clear();
+            overflow = true;
+        }
+        invalidations.push_back({as_id, address, size});
+        pending.store(true, std::memory_order_release);
+    }
+
+    u64 Hits() const { return hits; }
+    u64 Walks() const { return walks; }
+    u64 Removed() const { return removed; }
+    u64 RangeHits() const { return range_hits; }
+
+private:
+    struct Entry { size_t as_id; GPUVAddr address; u32 size; u32 prefix; };
+    struct Invalidation { size_t as_id; GPUVAddr address; u64 size; };
+
+    static bool Overlaps(GPUVAddr a, u64 a_size, GPUVAddr b, u64 b_size) {
+        if (!a_size || !b_size) return false;
+        return a <= b ? b - a < a_size : a - b < b_size;
+    }
+
+    void ApplyInvalidations() {
+        std::vector<Invalidation> changes;
+        bool clear;
+        {
+            std::scoped_lock lock{mutex};
+            pending.store(false, std::memory_order_relaxed);
+            changes.swap(invalidations);
+            clear = std::exchange(overflow, false);
+        }
+        if (clear) {
+            removed += entries.size();
+            entries.clear();
+            known_mapped.clear();
+            return;
+        }
+        if (use_intervals) {
+            for (const auto& change : changes) {
+                const auto known = known_mapped.find(change.as_id);
+                if (known == known_mapped.end()) continue;
+                if (change.size > std::numeric_limits<GPUVAddr>::max() - change.address) {
+                    known->second.Clear();
+                } else {
+                    known->second.Subtract(change.address, change.size);
+                }
+            }
+        }
+        for (auto it = entries.begin(); it != entries.end();) {
+            const auto& entry = it->second;
+            bool stale = false;
+            for (const auto& change : changes) {
+                stale |= entry.as_id == change.as_id &&
+                    Overlaps(entry.address, entry.size, change.address, change.size);
+                if (stale) break;
+            }
+            if (stale) {
+                ++removed;
+                const auto old = it++;
+                entries.erase(old);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    Common::unordered_map<u64, Entry> entries;
+    Common::unordered_map<size_t, Common::RangeSet<GPUVAddr>> known_mapped;
+    const bool use_intervals;
+    std::mutex mutex;
+    std::vector<Invalidation> invalidations;
+    std::atomic<bool> pending{};
+    bool overflow{};
+    u64 hits{}, walks{}, removed{}, range_hits{};
+};
+} // namespace VideoCommon
diff --git a/src/video_core/buffer_cache/reusable_storage_batch.h b/src/video_core/buffer_cache/reusable_storage_batch.h
new file mode 100644
index 0000000..fb9c92b
--- /dev/null
+++ b/src/video_core/buffer_cache/reusable_storage_batch.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <span>
+#include <vector>
+
+namespace VideoCommon {
+// Keep entry-owned allocations while excluding every entry from the preceding draw.
+template <typename Entry>
+class ReusableStorageBatch {
+public:
+    void Reset(bool retain) {
+        active = 0;
+        if (!retain) entries.clear();
+    }
+    std::span<Entry> Active() { return {entries.data(), active}; }
+    Entry& Append() {
+        if (active == entries.size()) entries.emplace_back();
+        return entries[active++];
+    }
+private:
+    std::vector<Entry> entries;
+    std::size_t active{};
+};
+} // namespace VideoCommon
