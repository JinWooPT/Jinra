+    REQUIRE(tracker.IsUsed(0, std::numeric_limits<u64>::max()));
+    REQUIRE(tracker.IsUsed(3 * 4096 + 93, 1));
+    REQUIRE_FALSE(tracker.IsUsed(std::numeric_limits<u64>::max(), 0));
