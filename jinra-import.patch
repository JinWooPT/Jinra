+    entries.fill(0xAAAAAAAAAAAAAAAAULL);
+    REQUIRE(VideoCommon::PackedPagesMatch(entries, 0, 96, 2));
+    REQUIRE(VideoCommon::PackedPagesMatch(entries, 31, 34, 2));
