+
+    tracker.Reset();
+    tracker.Track(4096, 4096);
+    REQUIRE_FALSE(tracker.IsUsed(0, 4096));
+    REQUIRE(tracker.IsUsed(4096, 4096));
+    REQUIRE_FALSE(tracker.IsUsed(8192, 4096));
+    tracker.Track(3 * 4096 + 92, 1);
+    REQUIRE(tracker.IsUsed(3 * 4096 + 92, 1));
