+    REQUIRE(VideoCommon::PackedPagesMatch(entries, 63, 1, 0));
+    REQUIRE_FALSE(VideoCommon::PackedPagesMatch(entries, 95, 2, 2));
+    REQUIRE_FALSE(VideoCommon::PackedPagesPresent(entries, 96, 1));
